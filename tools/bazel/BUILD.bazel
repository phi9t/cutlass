# Tools / Bazel extensions.
#
# Exports the rootfs guard (ADR 0006): a cc_library whose single source is
# generated by an action that hard-fails unless the CUDA build runs inside the
# bwrap rootfs. //third_party/cuda:cudart depends on it only when CUDA is
# enabled, so every CUDA target transitively enforces the invariant while the
# CPU header-only subset is untouched.

load("@rules_cc//cc:defs.bzl", "cc_library")
load(":rootfs_guard.bzl", "rootfs_guard")

package(default_visibility = ["//visibility:public"])

# True exactly when CUDA compilation is enabled (i.e. --config=cuda flips
# @rules_cuda//cuda:enable to True). This is the precise trigger for the guard.
config_setting(
    name = "cuda_enabled",
    flag_values = {"@rules_cuda//cuda:enable": "True"},
)

# Generates the stamp .cc, running (and gating on) the rootfs check action.
rootfs_guard(
    name = "rootfs_guard_stamp",
)

# Compilable carrier for the guard. Depending on this forces the stamp to be
# generated, which runs the check. Empty when built (the .cc has no symbols).
cc_library(
    name = "rootfs_guard",
    srcs = [":rootfs_guard_stamp"],
)
