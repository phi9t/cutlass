# Third-party CUTLASS wrapper.
#
# Re-exports the in-tree CUTLASS/CuTe headers from //include:cutlass.
# If CUTLASS is ever imported as a Bazel module, replace with an alias
# to the module target.

package(default_visibility = ["//visibility:public"])

alias(
    name = "cutlass",
    actual = "//include:cutlass_headers",
)
