# Third-party CUTLASS wrapper.
#
# CUTLASS is header-only and lives in the upstream tree at repo-root include/.
# This target is a stable alias so fork code depends on
# //third_party/cutlass:cutlass regardless of where the header tree sits; the
# real header cc_library is //include:cutlass. See ADR 0001/0002 — Bazel only
# exposes cutlass, never builds it, so this stays rebase-clean against upstream.

package(default_visibility = ["//visibility:public"])

alias(
    name = "cutlass",
    actual = "//include:cutlass",
)
