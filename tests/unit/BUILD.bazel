        "@googletest//:gtest",
    ],
)

cc_test(
    name = "gpt_config_test",
    srcs = ["gpt_model_test.cc"],
    size = "small",
    timeout = "short",
    deps = [
        "//src/model:gpt_model",
        "//tests:test_main",
        "//tests:test_utils",
        "@googletest//:gtest",
    ],
    tags = ["gpu"],
