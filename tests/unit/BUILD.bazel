# Tier A & B — Unit tests.
#
# Naming convention:
#   *_test       — host-only / CPU tests  (Tier A, size=small)
#   *_gpu_test   — single-GPU tests       (Tier B, size=medium)

package(default_visibility = ["//visibility:private"])

# ---- Tier A: host-only unit tests (no GPU) ----

cc_test(
    name = "core_test",
    srcs = ["core_test.cc"],
    size = "small",
    timeout = "short",
    deps = [
        "//src/core",
        "//tests:test_main",
        "@googletest//:gtest",
    ],
)

cc_test(
    name = "tensor_test",
    srcs = ["tensor_test.cc"],
    size = "small",
    timeout = "short",
    deps = [
        "//src/tensor",
        "//tests:test_main",
        "@googletest//:gtest",
    ],
)

