# Test infrastructure root.
#
# Shared test_main and test_utils are available to both
# collocated tests in src/ and cross-cutting tests in tests/.

load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = [
    "//src:__subpackages__",
    "//tests:__subpackages__",
])

cc_library(
    name = "test_main",
    srcs = ["test_main.cc"],
    deps = [
        "@googletest//:gtest",
    ],
)

# Shared test utilities (CPU reference oracles, helpers).
cc_library(
    name = "test_utils",
    hdrs = ["test_utils.h"],
    deps = [
        "//src/tensor",
    ],
)
