# Layer 1 — Core runtime substrate.
#
# Provides status/error handling, device guards, stream/event wrappers,
# and GPU memory allocators.  No math, no tensor semantics.

package(default_visibility = ["//src:__subpackages__"])

cc_library(
    name = "core",
    hdrs = [
        "allocator.h",
        "device.h",
        "event.h",
        "status.h",
        "stream.h",
    ],
    srcs = [
        "allocator.cc",
    ],
    deps = [
        "//third_party/cuda:cudart",
    ],
)

# ---- Tests ----

cc_test(
    name = "core_test",
    srcs = ["core_test.cc"],
    size = "small",
    timeout = "short",
    deps = [
        ":core",
        "//tests:test_main",
        "@googletest//:gtest",
    ],
)
