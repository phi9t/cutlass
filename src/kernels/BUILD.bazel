# Layer 2 — Primitive math kernels.
#
# GEMM, reductions, elementwise ops, layout transforms.
# Each sub-family is a separate target to keep dependencies narrow.

load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_cuda//cuda:defs.bzl", "cuda_library")

package(default_visibility = [
    "//src:__subpackages__",
    "//tests:__subpackages__",
])

cc_library(
    name = "gemm_problem",
    hdrs = ["gemm_problem.h"],
    deps = [
        "//src/core",
        "//src/tensor",
    ],
)

cuda_library(
    name = "gemm",
    hdrs = [
        "gemm.h",
        "gemm_cublaslt_internal.h",
    ],
    srcs = [
        "gemm_cutlass.cu",
        "gemm_cublaslt.cc",
    ],
    deps = [
        ":gemm_problem",
        "//src/core",
        "//src/tensor",
        "//third_party/cuda:cudart",
        "//third_party/cuda:cublaslt",
        "//third_party/cutlass",
    ],
    tags = ["cuda"],
)

cuda_library(
    name = "reductions",
    hdrs = ["reductions.h"],
    srcs = ["reductions.cu"],
    deps = [
        "//src/core",
        "//src/tensor",
        "//third_party/cuda:cudart",
    ],
    tags = ["cuda"],
)

cuda_library(
    name = "elementwise",
    hdrs = ["elementwise.h"],
    srcs = ["elementwise.cu"],
    deps = [
        "//src/core",
        "//src/tensor",
        "//third_party/cuda:cudart",
    ],
    tags = ["cuda"],
)

cuda_library(
    name = "layout_kernels",
    hdrs = ["layout_kernels.h"],
    srcs = ["layout_kernels.cu"],
    deps = [
        "//src/core",
        "//src/tensor",
        "//third_party/cuda:cudart",
    ],
    tags = ["cuda"],
)

# ---- Tests ----

cc_test(
    name = "gemm_problem_test",
    srcs = ["gemm_problem_test.cc"],
    size = "small",
    timeout = "short",
    deps = [
        ":gemm_problem",
        "//tests:test_main",
        "@googletest//:gtest",
    ],
)

cc_test(
    name = "gemm_test",
    srcs = ["gemm_test.cc"],
    size = "medium",
    timeout = "moderate",
    deps = [
        ":gemm",
        "//tests:test_main",
        "//tests:test_utils",
        "@googletest//:gtest",
    ],
    tags = ["gpu"],
)

cc_test(
    name = "reduction_test",
    srcs = ["reduction_test.cc"],
    size = "medium",
    timeout = "moderate",
    deps = [
        ":reductions",
        "//tests:test_main",
        "//tests:test_utils",
        "@googletest//:gtest",
    ],
    tags = ["gpu"],
)

cc_test(
    name = "elementwise_test",
    srcs = ["elementwise_test.cc"],
    size = "medium",
    timeout = "moderate",
    deps = [
        ":elementwise",
        "//tests:test_main",
        "//tests:test_utils",
        "@googletest//:gtest",
    ],
    tags = ["gpu"],
)
