# Layer 5 — Transformer block + GPT model.

package(default_visibility = [
    "//src:__subpackages__",
    "//tests:__subpackages__",
])

cc_library(
    name = "gpt_config",
    hdrs = ["gpt_config.h"],
)

cc_library(
    name = "gpt_params",
    hdrs = ["gpt_params.h"],
    deps = [
        ":gpt_config",
        "//src/attention",
        "//src/ops:layernorm",
        "//src/ops:linear",
        "//src/tensor",
    ],
)

cc_library(
    name = "gpt_block",
    hdrs = ["gpt_block.h"],
    srcs = ["gpt_block.cc"],
    deps = [
        ":gpt_config",
        ":gpt_params",
        "//src/attention",
        "//src/core",
        "//src/kernels:elementwise",
        "//src/ops:gelu",
        "//src/ops:layernorm",
        "//src/ops:linear",
        "//src/tensor",
    ],
)

cc_library(
    name = "gpt_model",
    hdrs = ["gpt_model.h"],
    srcs = ["gpt_model.cc"],
    deps = [
        ":gpt_block",
        ":gpt_config",
        ":gpt_params",
        "//src/core",
        "//src/kernels:elementwise",
        "//src/ops:embedding",
        "//src/ops:layernorm",
        "//src/ops:linear",
        "//src/tensor",
    ],
)

# ---- Tests ----

cc_test(
    name = "gpt_model_test",
    srcs = ["gpt_model_test.cc"],
    size = "medium",
    timeout = "moderate",
    deps = [
        ":gpt_model",
        "//src/ops:loss",
        "//tests:test_main",
        "//tests:test_utils",
        "//tests/integration:gpt_test_helpers",
        "@googletest//:gtest",
    ],
    tags = ["gpu"],
)

cc_test(
    name = "gpt_block_test",
    srcs = ["gpt_block_test.cc"],
    size = "medium",
    timeout = "moderate",
    deps = [
        ":gpt_block",
        "//tests:test_main",
        "//tests:test_utils",
        "@googletest//:gtest",
    ],
    tags = ["gpu"],
)
