# Layer 5 — Transformer block + GPT model.

load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_cuda//cuda:defs.bzl", "cuda_library")

package(default_visibility = [
    "//src:__subpackages__",
    "//tests:__subpackages__",
])

cc_library(
    name = "gpt_config",
    hdrs = ["gpt_config.h"],
)

cc_library(
    name = "gpt_params",
    hdrs = ["gpt_params.h"],
    srcs = ["gpt_params.cc"],
    deps = [
        ":gpt_config",
        "//src/attention",
        "//src/core",
        "//src/ops:layernorm",
        "//src/ops:linear",
        "//src/tensor",
    ],
)

cc_library(
    name = "gpt_block",
    hdrs = ["gpt_block.h"],
    srcs = ["gpt_block.cc"],
    deps = [
        ":gpt_config",
        ":gpt_params",
        "//src/attention",
        "//src/core",
        "//src/kernels:elementwise",
        "//src/ops:gelu",
        "//src/ops:layernorm",
        "//src/ops:linear",
        "//src/tensor",
    ],
)

cuda_library(
    name = "gpt_model_forward",
    hdrs = ["gpt_model_forward_internal.h"],
    srcs = ["gpt_model_forward.cu"],
    deps = [
        "//src/core",
        "//src/tensor",
        "//third_party/cuda:cudart",
    ],
    tags = ["cuda"],
)

cc_library(
    name = "gpt_model",
    hdrs = [
        "forward_workspace.h",
        "gpt_model.h",
    ],
    srcs = [
        "forward_workspace.cc",
        "gpt_model.cc",
    ],
    deps = [
        ":gpt_block",
        ":gpt_config",
        ":gpt_model_forward",
        ":gpt_params",
        "//src/core",
        "//src/ops:embedding",
        "//src/ops:layernorm",
        "//src/ops:linear",
        "//src/tensor",
    ],
)

# ---- Tests ----

cc_test(
    name = "gpt_model_test",
    srcs = ["gpt_model_test.cc"],
    size = "medium",
    timeout = "moderate",
    deps = [
        ":gpt_model",
        "//tests:test_main",
        "//tests:test_utils",
        "@googletest//:gtest",
    ],
    tags = ["gpu"],
)

cc_test(
    name = "gpt_block_test",
    srcs = ["gpt_block_test.cc"],
    size = "medium",
    timeout = "moderate",
    deps = [
        ":gpt_block",
        "//tests:test_main",
        "//tests:test_utils",
        "@googletest//:gtest",
    ],
    tags = ["gpu"],
)
