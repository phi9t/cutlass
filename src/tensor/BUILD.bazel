# Layer 1 — Tensor substrate.
#
# dtype, TensorView, layout/reshape utilities.
# Header-only; no CUDA runtime dependency.

package(default_visibility = [
    "//src:__subpackages__",
    "//tests:__subpackages__",
])

cc_library(
    name = "tensor",
    hdrs = [
        "dtype.h",
        "layout.h",
        "tensor_view.h",
    ],
)

# ---- Tests ----

cc_test(
    name = "tensor_test",
    srcs = ["tensor_test.cc"],
    size = "small",
    timeout = "short",
    deps = [
        ":tensor",
        "//tests:test_main",
        "@googletest//:gtest",
    ],
)

cc_test(
    name = "layout_test",
    srcs = ["layout_test.cc"],
    size = "small",
    timeout = "short",
    deps = [
        ":tensor",
        "//tests:test_main",
        "@googletest//:gtest",
    ],
)
