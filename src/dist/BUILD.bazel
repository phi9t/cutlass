# Layer 6 — Distributed: NCCL context and DDP.

load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = [
    "//src:__subpackages__",
    "//tests:__subpackages__",
])

cc_library(
    name = "nccl_context",
    hdrs = ["nccl_context.h"],
    srcs = ["nccl_context.cc"],
    deps = [
        "//src/core",
        "//third_party/nccl",
    ],
)

cc_library(
    name = "ddp",
    hdrs = ["ddp.h"],
    srcs = ["ddp.cc"],
    deps = [
        ":nccl_context",
        "//src/core",
        "//src/kernels:elementwise",
    ],
)

cc_library(
    name = "local_rank_runtime",
    hdrs = ["local_rank_runtime.h"],
    srcs = ["local_rank_runtime.cc"],
    deps = [
        ":nccl_context",
        "//src/core",
    ],
)

cc_test(
    name = "local_rank_runtime_test",
    srcs = ["local_rank_runtime_test.cc"],
    size = "small",
    timeout = "short",
    deps = [
        ":local_rank_runtime",
        "//tests:test_main",
        "@googletest//:gtest",
    ],
)
