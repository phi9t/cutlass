# Layer 7 — Data loading.

package(default_visibility = ["//src:__subpackages__"])

cc_library(
    name = "data",
    hdrs = [
        "batcher.h",
        "token_dataset.h",
    ],
    srcs = [
        "batcher.cc",
        "token_dataset.cc",
    ],
    deps = [
        "//src/core",
        "//third_party/cuda:cudart",
    ],
)

# ---- Tests ----

cc_test(
    name = "data_test",
    srcs = ["data_test.cc"],
    size = "small",
    timeout = "short",
    deps = [
        ":data",
        "//tests:test_main",
        "@googletest//:gtest",
    ],
)
