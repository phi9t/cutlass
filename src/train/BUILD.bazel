# Layer 6 — Training runtime.

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("@rules_cuda//cuda:defs.bzl", "cuda_library")

package(default_visibility = [
    "//src:__subpackages__",
    "//tests:__subpackages__",
])

cuda_library(
    name = "optimizer",
    hdrs = ["optimizer.h"],
    srcs = ["optimizer.cu"],
    deps = [
        "//src/core",
        "//src/tensor",
        "//third_party/cuda:cudart",
    ],
    tags = ["cuda"],
)

cc_library(
    name = "trainer",
    hdrs = ["trainer.h"],
    srcs = ["trainer.cc"],
    deps = [
        ":optimizer",
        "//src/core",
        "//src/dist:ddp",
        "//src/dist:nccl_context",
        "//src/model:gpt_model",
        "//src/model:gpt_params",
        "//src/ops:loss",
        "//src/tensor",
    ],
)

cc_binary(
    name = "gpt_trainer",
    srcs = ["main.cc"],
    deps = [
        ":trainer",
        "//src/core",
    ],
)

# ---- Tests ----

cc_test(
    name = "optimizer_test",
    srcs = ["optimizer_test.cc"],
    size = "small",
    timeout = "short",
    deps = [
        ":optimizer",
        "//tests:test_main",
        "@googletest//:gtest",
    ],
    tags = ["gpu"],
)
