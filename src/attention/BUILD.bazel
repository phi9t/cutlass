# Layer 4 — Attention subsystem.

load("@rules_cc//cc:defs.bzl", "cc_test")
load("@rules_cuda//cuda:defs.bzl", "cuda_library")

package(default_visibility = [
    "//src:__subpackages__",
    "//tests:__subpackages__",
])

cuda_library(
    name = "attention",
    hdrs = [
        "attention.h",
        "attention_forward_internal.h",
    ],
    srcs = [
        "attention.cc",
        "attention_forward.cu",
        "attention_backward.cu",
    ],
    deps = [
        "//src/core",
        "//src/tensor",
        "//src/kernels:gemm",
        "//src/kernels:layout_kernels",
        "//src/ops:linear",
        "//src/ops:softmax",
        "//third_party/cuda:cudart",
    ],
    tags = ["cuda"],
)

# ---- Tests ----

cc_test(
    name = "attention_forward_test",
    srcs = ["attention_forward_test.cc"],
    size = "medium",
    timeout = "moderate",
    deps = [
        ":attention",
        "//tests:test_main",
        "//tests:test_utils",
        "@googletest//:gtest",
    ],
    tags = ["gpu"],
)

cc_test(
    name = "attention_backward_test",
    srcs = ["attention_backward_test.cc"],
    size = "medium",
    timeout = "moderate",
    deps = [
        ":attention",
        "//tests:test_main",
        "//tests:test_utils",
        "@googletest//:gtest",
    ],
    tags = ["gpu"],
)
